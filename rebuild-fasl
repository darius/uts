set -e

echo Compiling fasl...
cp init.c init.c.backup
./uts build-fasl.scm init.c opcodes.scm primcodes.scm abcs/primitives.scm abcs/read.scm abcs/uts.scm
make

echo Compiled new fasl. If the test breaks, do mv init.c.backup init.c, then make.
./uts test/test.scm

if cmp init.c.backup init.c
then
  echo init.c unchanged.
else
  mv init.c.backup init.old.c
  echo New init.c built.
fi

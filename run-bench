#!/bin/bash
# Run benchmarks and save results
# Usage: ./run-bench [--save]
#   --save: save results to bench-results/<commit>.txt

set -e
cd "$(dirname "$0")"
export DYLD_LIBRARY_PATH=./gc/.libs

SAVE=0
if [ "$1" = "--save" ]; then
    SAVE=1
fi

mkdir -p bench-results

# Get current commit
COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")

run_one() {
    local name="$1"
    local expr="$2"

    local tmpfile=$(mktemp)
    local start=$(python3 -c 'import time; print(time.time())')
    echo "$expr" | ./uts > "$tmpfile" 2>&1
    local end=$(python3 -c 'import time; print(time.time())')
    local elapsed=$(python3 -c "print(f'{$end - $start:.4f}')")

    local val=$(grep -oE '[^ ]+$' "$tmpfile" | grep -v '^->$' | tail -1)
    rm -f "$tmpfile"

    printf "%s\t%s\t%s\n" "$name" "$elapsed" "$val"
}

# Run all benchmarks
results=$(
run_one "tak" "(define (tak x y z) (if (not (< y x)) z (tak (tak (- x 1) y z) (tak (- y 1) z x) (tak (- z 1) x y)))) (tak 24 16 8)"
run_one "fib" "(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))) (fib 35)"
run_one "ack" "(define (ack m n) (cond ((= m 0) (+ n 1)) ((= n 0) (ack (- m 1) 1)) (else (ack (- m 1) (ack m (- n 1)))))) (ack 3 7)"
run_one "sum" "(define (sum-to n) (let loop ((i 0) (acc 0)) (if (> i n) acc (loop (+ i 1) (+ acc i))))) (sum-to 10000000)"
run_one "sum-fp" "(define (sum-fp n) (let loop ((i 0) (acc 0.0)) (if (> i n) acc (loop (+ i 1) (+ acc (* i 1.0)))))) (sum-fp 10000000)"
run_one "fac" "(define (fac n) (if (<= n 1) 1 (* n (fac (- n 1))))) (do ((i 0 (+ i 1)) (r 0)) ((>= i 10000) r) (set! r (fac 19)))"
run_one "superopt" "(load \"superopt.scm\") (run-superopt)"
run_one "um" "(load \"um.scm\") (run-um-bench 100000)"
)

# Display results
echo "=== Benchmarks ($COMMIT) ==="
printf "%-12s %10s  %s\n" "Name" "Time(s)" "Result"
echo "$results" | while IFS=$'\t' read -r name time val; do
    printf "%-12s %10s  %s\n" "$name" "$time" "$val"
done

# Save if requested
if [ "$SAVE" = "1" ]; then
    outfile="bench-results/${COMMIT}.txt"
    echo "# Benchmark results for $COMMIT" > "$outfile"
    echo "# $(date -Iseconds)" >> "$outfile"
    echo "$results" >> "$outfile"
    echo "Saved to $outfile"

    # Set as baseline if no baseline exists
    if [ ! -f bench-results/baseline ]; then
        echo "$COMMIT" > bench-results/baseline
        echo "Set as baseline"
    fi
fi

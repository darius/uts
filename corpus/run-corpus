#!/bin/sh
# Run all corpus tests
# Usage: ./corpus/run-corpus

set -e

SCRIPTDIR="$(cd "$(dirname "$0")" && pwd)"
UTSDIR="$(dirname "$SCRIPTDIR")"
export UTS="$UTSDIR/uts"

run_test() {
    dir=$1
    echo "========================================"
    echo "Testing: $dir"
    echo "========================================"
    cd "$SCRIPTDIR/$dir"
    $UTS test.scm
    echo ""
}

run_test scheme-data-structures
run_test indent
run_test consp
run_test ridarama
run_test miasma

echo "========================================"
echo "All corpus tests passed!"
echo "========================================"

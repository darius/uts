#!/bin/sh
# Configure script for UTS

PREFIX="/usr/local"
GC_PREFIX=""
CC_OVERRIDE=""

# Parse arguments
for arg in "$@"; do
  case "$arg" in
    --prefix=*)
      PREFIX="${arg#--prefix=}"
      ;;
    --with-gc=*)
      GC_PREFIX="${arg#--with-gc=}"
      ;;
    CC=*)
      CC_OVERRIDE="${arg#CC=}"
      ;;
    --help|-h)
      echo "Usage: ./configure [options]"
      echo ""
      echo "Options:"
      echo "  --prefix=PATH     Install prefix (default: /usr/local)"
      echo "  --with-gc=PATH    Path to Boehm GC installation"
      echo "  CC=compiler       C compiler to use"
      echo ""
      exit 0
      ;;
    *)
      echo "Unknown option: $arg"
      echo "Try './configure --help' for usage"
      exit 1
      ;;
  esac
done

# Find a working C compiler
find_cc() {
  # Test if a compiler can compile a simple program
  test_cc() {
    echo '#include <stdio.h>' | "$1" -E - >/dev/null 2>&1
  }

  if [ -n "$CC_OVERRIDE" ]; then
    if test_cc "$CC_OVERRIDE"; then
      echo "$CC_OVERRIDE"
    else
      echo "Error: specified compiler '$CC_OVERRIDE' doesn't work" >&2
      exit 1
    fi
  elif [ -n "$CC" ] && test_cc "$CC"; then
    echo "$CC"
  elif test_cc cc; then
    echo ""  # empty means use make's default
  elif test_cc gcc; then
    echo "gcc"
  elif test_cc clang; then
    echo "clang"
  else
    echo "Error: no working C compiler found" >&2
    exit 1
  fi
}

CC_RESULT=$(find_cc)
if [ -n "$CC_RESULT" ]; then
  echo "Using C compiler: $CC_RESULT"
else
  echo "Using C compiler: cc (default)"
fi

# Try to find Boehm GC
GC_CFLAGS=""
GC_LIBS=""

if [ -n "$GC_PREFIX" ]; then
  # User specified --with-gc
  if [ -f "$GC_PREFIX/include/gc.h" ]; then
    GC_CFLAGS="-I$GC_PREFIX/include"
    GC_LIBS="-L$GC_PREFIX/lib -lgc"
    echo "Using Boehm GC from: $GC_PREFIX"
  elif [ -f "$GC_PREFIX/include/gc/gc.h" ]; then
    GC_CFLAGS="-I$GC_PREFIX/include/gc"
    GC_LIBS="-L$GC_PREFIX/lib -lgc"
    echo "Using Boehm GC from: $GC_PREFIX"
  else
    echo "Error: gc.h not found in $GC_PREFIX/include or $GC_PREFIX/include/gc"
    exit 1
  fi
elif [ -f "gc/include/gc.h" ] && [ -f "gc/gc.a" ]; then
  # Local build in gc/ subdirectory
  GC_CFLAGS="-I./gc/include"
  GC_LIBS="./gc/gc.a"
  echo "Using Boehm GC from local gc/ directory"
elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists bdw-gc 2>/dev/null; then
  # Try pkg-config
  GC_CFLAGS=$(pkg-config --cflags bdw-gc)
  GC_LIBS=$(pkg-config --libs bdw-gc)
  echo "Using Boehm GC from pkg-config"
else
  # Try common prefixes
  for prefix in /usr/local /usr "$HOME/.local" /opt/local /opt/homebrew; do
    if [ -f "$prefix/include/gc.h" ]; then
      GC_CFLAGS="-I$prefix/include"
      GC_LIBS="-L$prefix/lib -lgc"
      echo "Using Boehm GC from: $prefix"
      break
    elif [ -f "$prefix/include/gc/gc.h" ]; then
      GC_CFLAGS="-I$prefix/include/gc"
      GC_LIBS="-L$prefix/lib -lgc"
      echo "Using Boehm GC from: $prefix"
      break
    fi
  done
fi

# If still not found, assume system default
if [ -z "$GC_LIBS" ]; then
  GC_LIBS="-lgc"
  echo "Assuming Boehm GC is in system path"
fi

# Write config.mk
{
  echo "# Generated by configure"
  [ -n "$CC_RESULT" ] && echo "CC = $CC_RESULT"
  echo "PREFIX = $PREFIX"
  echo "GC_CFLAGS = $GC_CFLAGS"
  echo "GC_LIBS = $GC_LIBS"
} > config.mk

# Write uts script
here="$(dirname "$(realpath "$0")")"
echo ${here}/utsvm ${here}/uts.fasl '"$@"' >uts
chmod +x uts

echo ""
echo "Configuration summary:"
[ -n "$CC_RESULT" ] && echo "  CC:       $CC_RESULT"
echo "  PREFIX:    $PREFIX"
echo "  GC_CFLAGS: $GC_CFLAGS"
echo "  GC_LIBS:   $GC_LIBS"
echo ""
echo "Run 'make' to build (release mode)"
echo "Run 'make DEBUG=1' to build with debugging"
echo "Run 'make install' to install"
